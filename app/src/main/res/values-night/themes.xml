<?xml version="1.0" encoding="utf-8"?>
<!-- DARK MODE theme overrides. -->
<resources>
    <style name="Theme.PixelParlor" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/surface</item>
        <item name="colorOnPrimary">@color/color_on_accent</item>
        <item name="colorSecondary">@color/accent_red</item>
        <item name="colorOnSecondary">@color/color_on_accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <!-- Dark mode: light icons on the dark status bar -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
