<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#28AA44FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#50AA44FF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <!-- Border + background -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D0A14" />
            <stroke android:width="1dp" android:color="#AA44FF" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
