<?xml version="1.0" encoding="utf-8"?>
<!-- Cave Diver rank chip icon — ship with cockpit cutout and mini cave spikes -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="12dp"
    android:viewportWidth="32"
    android:viewportHeight="16">

    <!-- Mini stalactite above ship (downward spike, 60% opacity so it reads as cave detail) -->
    <path
        android:fillColor="#99FFFFFF"
        android:pathData="M11,0 L15,4 L19,0 Z" />

    <!-- Ship body with cockpit punched out via evenOdd fill rule -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M30,8 L0,3 L3,8 L0,13 Z M20,8 m-3,0 a3,1.5 0 1,0 6,0 a3,1.5 0 1,0 -6,0 Z" />

    <!-- Mini stalagmite below ship (upward spike) -->
    <path
        android:fillColor="#99FFFFFF"
        android:pathData="M11,16 L15,12 L19,16 Z" />

</vector>
