<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal ship silhouette for rank chips — tinted at runtime via SRC_IN color filter -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="12dp"
    android:viewportWidth="32"
    android:viewportHeight="16">

    <!-- Ship body: right-pointing dart (matches the in-game ship path) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,8 L0,0 L4,8 L0,16 Z" />

    <!-- Cockpit: transparent cutout so the chip shows the body shape cleanly -->
    <path
        android:fillColor="#00000000"
        android:pathData="M26,8 m-5,0 a5,3.5 0 1,0 10,0 a5,3.5 0 1,0 -10,0 Z" />

</vector>
