<?xml version="1.0" encoding="utf-8"?>
<!--
  To enable the Press Start 2P pixel font:
  1. Download PressStart2P-Regular.ttf from https://fonts.google.com/specimen/Press+Start+2P
  2. Place it at  app/src/main/res/font/press_start_2p.ttf
  3. Replace this file's contents with:

     <font-family xmlns:android="http://schemas.android.com/apk/res/android">
         <font android:fontStyle="normal" android:fontWeight="400"
               android:font="@font/press_start_2p" />
     </font-family>

  4. In all layout XMLs, change android:fontFamily="monospace"
     back to android:fontFamily="@font/press_start_2p"

  Until then, layouts fall back to system monospace (still retro-ish).
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android" />
