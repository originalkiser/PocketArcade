<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050510">

    <!-- Main column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Banner ad slot -->
        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_ad_banner" />

        <!-- Title header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:background="#07071A">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POCKET ARCADE"
                android:textColor="@color/accent_blue"
                android:textSize="26sp"
                android:fontFamily="@font/press_start_2p"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvSelectGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="=  SELECT YOUR GAME  ="
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="@font/press_start_2p"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent_blue"
            android:alpha="0.3" />

        <!-- Game list -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- SNAKE -->
                <LinearLayout
                    android:id="@+id/tileSnake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_snake"
                        android:contentDescription="Snake" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/game_snake"
                            android:textColor="@color/accent_blue"
                            android:textSize="19sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScoreSnake"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScoreSnakeDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_blue"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#x25B6;"
                        android:textColor="@color/accent_blue"
                        android:textSize="18sp"
                        android:alpha="0.5"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- PONG -->
                <LinearLayout
                    android:id="@+id/tilePong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_pong"
                        android:contentDescription="Pong" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/game_pong"
                            android:textColor="@color/accent_red"
                            android:textSize="19sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScorePong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScorePongDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_red"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#x25B6;"
                        android:textColor="@color/accent_red"
                        android:textSize="18sp"
                        android:alpha="0.5"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- ASTEROIDS -->
                <LinearLayout
                    android:id="@+id/tileAsteroids"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_asteroids"
                        android:contentDescription="Asteroids" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/game_asteroids"
                            android:textColor="@color/accent_cyan"
                            android:textSize="19sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScoreAsteroids"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScoreAsteroidsDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#x25B6;"
                        android:textColor="@color/accent_cyan"
                        android:textSize="18sp"
                        android:alpha="0.5"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- BRICK BREAKER -->
                <LinearLayout
                    android:id="@+id/tileBrickBreaker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_brickbreaker"
                        android:contentDescription="Brick Breaker" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/game_brickbreaker"
                            android:textColor="@color/accent_yellow"
                            android:textSize="19sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScoreBrickBreaker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScoreBBDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_yellow"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#x25B6;"
                        android:textColor="@color/accent_yellow"
                        android:textSize="18sp"
                        android:alpha="0.5"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- GLOBAL SCORES button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1.5" />

                    <TextView
                        android:id="@+id/btnGlobalScores"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:text="&#127758;  GLOBAL SCORES  &#127758;"
                        android:textColor="@color/accent_blue"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:background="@drawable/bg_game_tile"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1.5" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/muted"
            android:alpha="0.2" />

        <!-- Bottom buttons: Settings · Profile · Friends as equal circles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#07071A"
            android:paddingVertical="10dp"
            android:paddingHorizontal="20dp"
            android:gravity="center">

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_btn">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="&#9881;"
                        android:textColor="@color/muted"
                        android:textSize="24sp"
                        android:gravity="center" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETTINGS"
                    android:textColor="@color/muted"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Profile (avatar filled programmatically) -->
            <LinearLayout
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/profileCircle"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_btn" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILE"
                    android:textColor="@color/muted"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Friends -->
            <LinearLayout
                android:id="@+id/btnFriends"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_btn">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="&#128101;"
                        android:textSize="26sp"
                        android:gravity="center" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FRIENDS"
                    android:textColor="@color/muted"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Top scores ticker -->
        <TextView
            android:id="@+id/tvMarquee"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="TOP SCORES  *  PLAY TO SET RECORDS  *"
            android:textColor="@color/accent_yellow"
            android:textSize="20sp"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:background="#03030E"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:scrollHorizontally="true" />

    </LinearLayout>

    <!-- CRT scanline + vignette overlay (non-interactive) -->
    <com.pocketarcade.CrtOverlayView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
