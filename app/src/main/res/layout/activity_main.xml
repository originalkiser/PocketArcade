<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050510">

    <!-- ── Main column ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Banner ad slot -->
        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_ad_banner" />

        <!-- Title header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:background="#07071A">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POCKET ARCADE"
                android:textColor="@color/accent_blue"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvSelectGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="≡  SELECT YOUR GAME  ≡"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent_blue"
            android:alpha="0.3" />

        <!-- Game grid -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Row 1: Snake | Pong -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:id="@+id/tileSnake"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_snake"
                            android:contentDescription="Snake" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/game_snake"
                            android:textColor="@color/accent_blue"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScoreSnake"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="8sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScoreSnakeDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_blue"
                            android:textSize="7sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tilePong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_pong"
                            android:contentDescription="Pong" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/game_pong"
                            android:textColor="@color/accent_red"
                            android:textSize="10sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScorePong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="8sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScorePongDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_red"
                            android:textSize="7sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Asteroids | Brick Breaker -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/tileAsteroids"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_asteroids"
                            android:contentDescription="Asteroids" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/game_asteroids"
                            android:textColor="@color/accent_cyan"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScoreAsteroids"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="8sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScoreAsteroidsDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_cyan"
                            android:textSize="7sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tileBrickBreaker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_brickbreaker"
                            android:contentDescription="Brick Breaker" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/game_brickbreaker"
                            android:textColor="@color/accent_yellow"
                            android:textSize="7sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScoreBrickBreaker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="8sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScoreBBDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_yellow"
                            android:textSize="7sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/muted"
            android:alpha="0.2" />

        <!-- Bottom control bar: Settings | Credits -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="#07071A"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚙  SETTINGS"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="@color/muted"
                android:alpha="0.3" />

            <TextView
                android:id="@+id/btnCredits"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="★  CREDITS"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- INSERT COIN marquee -->
        <TextView
            android:id="@+id/tvMarquee"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:text="✦  INSERT COIN  ✦  POCKET ARCADE  ✦  LOFTICE PRODUCTIONS  ✦  INSERT COIN  ✦  POCKET ARCADE  ✦"
            android:textColor="@color/accent_blue"
            android:textSize="8sp"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:background="#03030E"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:scrollHorizontally="true" />

    </LinearLayout>

    <!-- CRT scanline + vignette overlay (non-interactive) -->
    <com.pocketarcade.CrtOverlayView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
