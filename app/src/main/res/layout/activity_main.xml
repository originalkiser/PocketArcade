<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050510">

    <!-- Main column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Banner ad slot -->
        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_ad_banner" />

        <!-- Title header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            android:background="#07071A">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POCKET ARCADE"
                android:textColor="@color/accent_blue"
                android:textSize="26sp"
                android:fontFamily="@font/press_start_2p"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvSelectGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="=  SELECT YOUR GAME  ="
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="@font/press_start_2p"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent_blue"
            android:alpha="0.3" />

        <!-- Game list -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- SNAKE -->
                <LinearLayout
                    android:id="@+id/tileSnake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_snake"
                        android:contentDescription="Snake" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/game_snake"
                            android:textColor="@color/accent_blue"
                            android:textSize="19sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScoreSnake"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScoreSnakeDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_blue"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#x25B6;"
                        android:textColor="@color/accent_blue"
                        android:textSize="18sp"
                        android:alpha="0.5"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- PONG -->
                <LinearLayout
                    android:id="@+id/tilePong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_pong"
                        android:contentDescription="Pong" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/game_pong"
                            android:textColor="@color/accent_red"
                            android:textSize="19sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScorePong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScorePongDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_red"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#x25B6;"
                        android:textColor="@color/accent_red"
                        android:textSize="18sp"
                        android:alpha="0.5"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- ASTEROIDS -->
                <LinearLayout
                    android:id="@+id/tileAsteroids"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_asteroids"
                        android:contentDescription="Asteroids" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/game_asteroids"
                            android:textColor="@color/accent_cyan"
                            android:textSize="19sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScoreAsteroids"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScoreAsteroidsDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_cyan"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#x25B6;"
                        android:textColor="@color/accent_cyan"
                        android:textSize="18sp"
                        android:alpha="0.5"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- BRICK BREAKER -->
                <LinearLayout
                    android:id="@+id/tileBrickBreaker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_brickbreaker"
                        android:contentDescription="Brick Breaker" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/game_brickbreaker"
                            android:textColor="@color/accent_yellow"
                            android:textSize="19sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScoreBrickBreaker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="High Score: 0"
                            android:textColor="@color/muted"
                            android:textSize="13sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvScoreBBDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/accent_yellow"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#x25B6;"
                        android:textColor="@color/accent_yellow"
                        android:textSize="18sp"
                        android:alpha="0.5"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- RECORD BOOK: 70% width, centered -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1.5" />

                    <LinearLayout
                        android:id="@+id/btnRecordBook"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:orientation="vertical"
                        android:background="@drawable/bg_record_book"
                        android:padding="14dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="[ RECORD BOOK ]"
                            android:textColor="#AA44FF"
                            android:textSize="19sp"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRecordBookSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="NO MISSIONS LOGGED YET"
                            android:textColor="#666688"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:gravity="center" />

                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1.5" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/muted"
            android:alpha="0.2" />

        <!-- Bottom buttons: Settings and Credits as separate cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#07071A"
            android:padding="10dp"
            android:gravity="center">

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="SETTINGS"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:background="@drawable/bg_btn_bottom"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnCredits"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="CREDITS"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:background="@drawable/bg_btn_bottom"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Top scores ticker -->
        <TextView
            android:id="@+id/tvMarquee"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="TOP SCORES  *  PLAY TO SET RECORDS  *"
            android:textColor="@color/accent_yellow"
            android:textSize="20sp"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:background="#03030E"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:scrollHorizontally="true" />

    </LinearLayout>

    <!-- CRT scanline + vignette overlay (non-interactive) -->
    <com.pocketarcade.CrtOverlayView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
