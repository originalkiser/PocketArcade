<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Banner ad at top -->
    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_ad_banner" />

    <!-- Header row: back button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical"
        android:background="@color/color_hud_bg_alpha">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="&lt; MENU"
            android:textColor="@color/color_hud_match"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Game view fills remaining space -->
    <com.pocketarcade.games.memorymatch.MemoryMatchView
        android:id="@+id/memoryMatchView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom bar: ☀/🌙 | 📳 | 🔊 | 🏆 | ⚙ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnLightModeMatch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#127769;"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnHapticsMatch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#128243;"
            android:textSize="17sp"
            android:textColor="@color/color_hud_match"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnSoundMatch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#128266;"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnLeaderboardMatch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#127942;"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#9881;"
            android:textColor="@color/muted"
            android:textSize="17sp"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
