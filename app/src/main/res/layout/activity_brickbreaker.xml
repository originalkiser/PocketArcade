<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_ad_banner" />

    <!-- Two-row header: score/level + hearts/high score -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface">

        <!-- Row 1: back, score, level -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingHorizontal="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="&lt; MENU"
                android:textColor="@color/accent_yellow"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_game_tile"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SCORE: 0"
                android:textColor="@color/accent_yellow"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LV:1"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Row 2: hearts (left) + high score (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:paddingHorizontal="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLives"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="&#9829;&#9829;&#9829;"
                android:textColor="@color/accent_red"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvHighScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH SCORE: 0"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <!-- Game board + floating start-game overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

        <com.pocketarcade.games.brickbreaker.BrickBreakerView
            android:id="@+id/brickBreakerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/btnStartGame"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:text="▶  START GAME"
            android:textColor="@color/accent_yellow"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/swipeZone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_game_tile"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="&#9664;  swipe to move paddle  *  tap to launch  &#9654;"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </FrameLayout>

    <!-- Bottom settings bar: 🌙 | 🔊 | 🏆 | ⚙ -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnLightMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#127769;"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnSound"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#128266;"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnLeaderboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#127942;"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#9881;"
            android:textColor="@color/muted"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
