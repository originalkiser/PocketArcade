<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnProfileBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;"
            android:textColor="@color/accent_blue"
            android:textSize="22sp"
            android:fontFamily="monospace"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PROFILE"
            android:textColor="@color/accent_blue"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <!-- EDIT button — shown when registered -->
        <TextView
            android:id="@+id/btnEditProfile"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="EDIT"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Avatar section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/surface"
        android:paddingVertical="20dp"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:id="@+id/profileAvatarContainer"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal" />

        <!-- Avatar edit buttons — only visible in edit mode -->
        <LinearLayout
            android:id="@+id/layoutAvatarEditButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnProfileChangeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="EMOJI"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:background="@drawable/bg_game_tile"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnProfileUploadPhoto"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="UPLOAD PHOTO"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:background="@drawable/bg_game_tile"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- No-profile callout (shown when not registered) -->
    <LinearLayout
        android:id="@+id/layoutNoProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile not created — not posting to global leaderboards."
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/btnCreateProfile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CREATE PROFILE"
            android:textColor="@color/color_on_accent"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@color/accent_blue"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Profile content scroll (shown when registered) -->
    <ScrollView
        android:id="@+id/layoutProfileForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── VIEW MODE section ── -->
            <LinearLayout
                android:id="@+id/layoutViewMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USERNAME"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvViewUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:background="@drawable/bg_game_tile"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCATION"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvViewLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:background="@drawable/bg_game_tile"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

            <!-- ── EDIT MODE section ── -->
            <LinearLayout
                android:id="@+id/layoutEditMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USERNAME"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp"
                    android:layout_marginTop="8dp" />

                <EditText
                    android:id="@+id/etProfileUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_game_tile"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:inputType="textNoSuggestions"
                    android:maxLength="20"
                    android:hint="3-20 chars, letters/numbers/underscore"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvProfileUsernameError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COUNTRY"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp"
                    android:layout_marginTop="8dp" />

                <Spinner
                    android:id="@+id/spinnerProfileCountry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_game_tile"
                    android:padding="4dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/layoutProfileState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STATE / PROVINCE"
                        android:textColor="@color/muted"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spinnerProfileState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_game_tile"
                        android:padding="4dp"
                        android:layout_marginBottom="8dp" />

                </LinearLayout>

                <!-- Save Changes button — shown only when dirty -->
                <TextView
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="SAVE CHANGES"
                    android:textColor="@color/color_on_accent"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:background="@color/accent_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSaveStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

            <!-- ── Score Highlights section (always visible when registered) ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCORE HIGHLIGHTS"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/profileHighlightsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- View Full Record Book button -->
            <TextView
                android:id="@+id/btnViewRecordBook"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="VIEW FULL RECORD BOOK"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:background="@drawable/bg_game_tile"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
