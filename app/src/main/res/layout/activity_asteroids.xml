<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_ad_banner" />

    <!-- Top bar: back button + score display only -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingHorizontal="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="&lt; MENU"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SCORE: 0"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/tvHighScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Best: 0"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Game area -->
    <com.pocketarcade.games.asteroids.AsteroidsView
        android:id="@+id/asteroidsView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3" />

    <!-- Joystick + fire controls panel -->
    <com.pocketarcade.games.asteroids.AsteroidsControlsView
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:clickable="true"
        android:focusable="true" />

    <!-- Bottom settings bar: AUTO | 🌙 | 🔊 | 🏆 | ⚙ -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnAutoFire"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="AUTO"
            android:textColor="@color/muted"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnLightMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#127769;"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnHaptics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#128243;"
            android:textSize="17sp"
            android:textColor="@color/accent_cyan"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnSound"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#128266;"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnLeaderboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#127942;"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="&#9881;"
            android:textColor="@color/muted"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
