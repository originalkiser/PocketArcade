<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="&#128101; FRIENDS"
        android:textColor="@color/accent_blue"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textStyle="bold"
        android:paddingBottom="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ADD A FRIEND"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etFriendUsername"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_game_tile"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:inputType="textNoSuggestions"
            android:hint="username"
            android:maxLength="20"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/btnAddFriend"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="ADD"
            android:textColor="@color/accent_green"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvFriendAddStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnFindContacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="FROM CONTACTS"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnShareProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="SHARE PROFILE"
            android:textColor="@color/accent_yellow"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FOLLOWING"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:paddingTop="14dp"
        android:paddingBottom="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="160dp">

        <LinearLayout
            android:id="@+id/friendsListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <ProgressBar
        android:id="@+id/progressFriends"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvFriendsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No friends yet — add some above!"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnFriendsClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="CLOSE"
        android:textColor="@color/accent_blue"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:background="@drawable/bg_game_tile"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
