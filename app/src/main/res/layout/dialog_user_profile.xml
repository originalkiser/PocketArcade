<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface"
    android:gravity="center_horizontal">

    <FrameLayout
        android:id="@+id/profileDialogAvatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvProfileUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@username"
        android:textColor="@color/accent_blue"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProfileLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginTop="4dp" />

    <!-- Score highlights (populated at runtime) -->
    <LinearLayout
        android:id="@+id/profileScoresContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnFollowUser"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="+ ADD FRIEND"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:background="@drawable/bg_game_tile"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnCloseProfile"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:text="CLOSE"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
