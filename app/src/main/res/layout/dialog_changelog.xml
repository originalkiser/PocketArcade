<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="20dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="3dp"
            android:layout_height="28dp"
            android:background="@color/accent_yellow"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHAT'S NEW"
                android:textColor="@color/accent_yellow"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChangelogVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.3.0"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/accent_yellow"
        android:alpha="0.2"
        android:layout_marginBottom="14dp" />

    <!-- Changelog content -->
    <TextView
        android:id="@+id/tvChangelog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="18dp" />

    <!-- Close button -->
    <TextView
        android:id="@+id/btnChangelogClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="[ LET'S PLAY ]"
        android:textColor="@color/accent_yellow"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textStyle="bold"
        android:background="@drawable/bg_game_tile"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
