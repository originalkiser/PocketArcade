<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#1A0F08">

    <TextView
        android:id="@+id/btnDiffBack"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="&lt; MENU"
        android:textColor="#FF6B35"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_game_tile"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BLOCK DROP"
        android:textColor="#FF6B35"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELECT DIFFICULTY"
        android:textColor="#AA6040"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <!-- EASY -->
    <LinearLayout
        android:id="@+id/btnEasy"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_game_tile"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EASY"
            android:textColor="#00FF96"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8×10 board  •  3 colors"
            android:textColor="#446655"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- MEDIUM -->
    <LinearLayout
        android:id="@+id/btnMedium"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_game_tile"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDIUM"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10×12 board  •  3–4 colors"
            android:textColor="#446655"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- HARD -->
    <LinearLayout
        android:id="@+id/btnHard"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_game_tile"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HARD"
            android:textColor="#FF4444"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12×14 board  •  4–5 colors"
            android:textColor="#446655"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </LinearLayout>

</LinearLayout>
