<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="&#127758; GLOBAL LEADERBOARD"
        android:textColor="@color/accent_blue"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textStyle="bold"
        android:paddingBottom="2dp" />

    <TextView
        android:id="@+id/tvCurrentGame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Game chip selector -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/gameChipsRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <!-- Mode chip selector — visible only for Brick Breaker -->
    <HorizontalScrollView
        android:id="@+id/modeChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:scrollbars="none"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/modeChipsRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <!-- WORLD / LOCAL / FRIENDS tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tabWorld"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="WORLD"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabLocal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="YOUR REGION"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tabFriends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="FRIENDS"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Sub-tabs shown only for FRIENDS tab -->
    <LinearLayout
        android:id="@+id/friendsBar"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tabFriendsWeek"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="WEEK"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabFriendsMonth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="MONTH"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabFriendsAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="ALL TIME"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnManageFriends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="&#128101; MANAGE"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="@drawable/bg_game_tile"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Column header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="@color/border">

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:text="#"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="end" />

        <!-- Avatar column spacer -->
        <View
            android:layout_width="32dp"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PLAYER"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="start" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="SCORE"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="end" />

        <TextView
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:text="REGION"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="end" />

    </LinearLayout>

    <!-- Scrollable entry list — takes all remaining vertical space -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/globalContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <ProgressBar
        android:id="@+id/progressGlobal"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvGlobalEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No scores yet - be the first!"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnLoadMore"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:text="LOAD MORE ▼"
        android:textColor="@color/accent_blue"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:background="@drawable/bg_game_tile"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnGlobalClose"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:text="CLOSE"
        android:textColor="@color/accent_blue"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:background="@drawable/bg_game_tile"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
