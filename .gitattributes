# Force LF line endings for shell scripts (gradlew must not have CRLF on Linux runners)
gradlew        text eol=lf
*.sh           text eol=lf

# Windows batch files keep CRLF
*.bat          text eol=crlf

# All other text files: normalise to LF in the repo
*.kt           text eol=lf
*.kts          text eol=lf
*.xml          text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.md           text eol=lf
*.properties   text eol=lf
*.toml         text eol=lf
*.pro          text eol=lf
*.json         text eol=lf

# Binaries — no line-ending conversion
*.jar          binary
*.png          binary
*.jpg          binary
*.apk          binary
