rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Username claim is atomic via transaction; once set, immutable
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                   && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    // User profiles: publicly readable, only owner can write
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Scores: anyone can read; authenticated users can create only (no edits)
    // uid in document must match the submitter, score must be a non-negative int
    match /globalScores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null
                   && request.resource.data.uid == request.auth.uid
                   && request.resource.data.score is int
                   && request.resource.data.score >= 0;
      allow update, delete: if false;
    }
  }
}
